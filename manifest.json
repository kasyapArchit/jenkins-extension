{
  "manifest_version": 3,
  "name": "Jenkins Launcher",
  "version": "0.8.2",
  "description": "Trigger starred Jenkins pipelines with saved parameters and watch their status.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jenkins Launcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16-mark.png",
      "32": "icons/32-mark.png",
      "48": "icons/48-mark.png",
      "128": "icons/128-mark.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16-dark.png",
    "32": "icons/32-dark.png",
    "48": "icons/48-dark.png",
    "128": "icons/128-dark.png"
  }
}
